# LOCAL DEVELOPMENT: set FOODBRIDGE_DB_BACKEND=sqlite if you want a local SQLite file.
# CLOUD DEPLOYMENT: set FOODBRIDGE_DB_BACKEND=mysql and fill in hosted MySQL values below.
FOODBRIDGE_DB_BACKEND=mysql
FOODBRIDGE_DB=./foodbridge.db

# Generate a unique random secret (32+ characters) and choose a strong password (12+ characters).
FOODBRIDGE_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
FOODBRIDGE_ADMIN_USERNAME=admin
FOODBRIDGE_ADMIN_EMAIL=admin@example.com
FOODBRIDGE_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# For a clean cloud database, leave demo seeding false.
# Set to true only for a local/demo environment; demo accounts use public demo credentials.
FOODBRIDGE_SEED_DEMO_DATA=false

# Set this to your exact GitHub Pages origin, plus local dev origins if needed.
# Example: https://YOUR-USERNAME.github.io,http://127.0.0.1:5500
FRONTEND_ORIGINS=https://YOUR-USERNAME.github.io,http://127.0.0.1:5500,http://localhost:5500

# Hosted MySQL connection details from your provider
MYSQL_HOST=your-mysql-hostname
MYSQL_PORT=3306
MYSQL_DATABASE=foodbridge
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password

# Path to the cloud DB provider's CA certificate; if supported by the provider use this.
MYSQL_SSL_CA=ca.pem
MYSQL_SSL_REQUIRED=true

# Optional: TinyFish API key for FoodTrust public research
TINYFISH_API_KEY=

# Render sets RENDER automatically. Do not set FLASK_DEBUG=true in production.
FLASK_DEBUG=false
